# Data: raw and derived data are regenerated by `make data`; never committed.
data/raw/
data/derived/
data/lab/
# Collaborator lab data must never be committed or uploaded anywhere.
**/lab_data/
*.mzML
*.mzml
# ClassyFire lookup cache IS committed (public structures only) for reproducibility.
!data/cache/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
.RData
.Rhistory
external/
*.log

# SIRIUS projects (large); summaries are kept
cosmic/results/*.sirius
cosmic/run_console.txt
cosmic/customdb/results/*.sirius
cosmic/customdb/dbs/
cosmic/customdb/results/.done_*
# owner's local files (never tracked)
.RData
.Rhistory
.DS_Store
cosmic/_to_delete/
# SIRIUS by-products kept on the owner's Mac (only structure_identifications.tsv is tracked)
cosmic/results/log_*.txt
cosmic/customdb/results/log_*.txt
cosmic/results/summaries_*/*
!cosmic/results/summaries_*/structure_identifications.tsv
cosmic/customdb/results/summaries_*/*
!cosmic/customdb/results/summaries_*/structure_identifications.tsv
